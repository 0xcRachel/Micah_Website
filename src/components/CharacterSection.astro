---
// CharacterSection.astro — Interactive Brand Companion Stage
---
<section id="character" class="section-wrapper character-section" data-section="character">
  <div class="container-editorial character-layout">
    <div class="char-editorial-block">
      <span class="badge-tag">
        <span class="dot"></span>
        <span>08 // BRAND COMPANION</span>
      </span>
      <h2 class="text-title anim-title">A LIVING COMPANION EMBEDDED IN YOUR WORKFLOW.</h2>
      <p class="char-desc text-secondary anim-fade">
        The application features an interactive chibi companion serving as your desktop co-pilot. Click to trigger quick actions, observe organic eye blinks and head tracking, and feel genuine responsiveness right on your desktop.
      </p>

      <div class="character-action-card anim-fade">
        <div class="action-card-header text-mono">
          <span class="accent-signal">QUICK ACTION HUB</span>
          <span>INTERACTIVE TRIGGERS</span>
        </div>
        <div class="action-btn-group">
          <button id="btn-poke-char" class="btn-magnetic btn-ghost-minimal">
            <span>TRIGGER REACTION</span>
          </button>
          <a href="#download" class="btn-magnetic btn-primary-signal">
            <span>EXPERIENCE IN APP</span>
          </a>
        </div>
      </div>
    </div>

    <div class="char-viewport-guide" aria-hidden="true">
      <div class="guide-box">
        <div class="guide-corner tl"></div>
        <div class="guide-corner tr"></div>
        <div class="guide-corner bl"></div>
        <div class="guide-corner br"></div>
        <span class="guide-caption text-mono">3D PROCEDURAL STAGE // SECONDARY DELAY ACTIVE</span>
      </div>
    </div>
  </div>
</section>

<style>
.character-section {
  min-height: 110vh;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
}

.character-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4vw;
}

@media (max-width: 960px) {
  .character-layout {
    grid-template-columns: 1fr;
  }
}

.char-editorial-block {
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
  z-index: 2;
}

.char-desc {
  font-size: var(--font-16);
  line-height: 1.6;
}

.character-action-card {
  border: 1px solid var(--border-subtle);
  background: rgba(12, 12, 14, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  margin-top: 1rem;
}

.action-card-header {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  letter-spacing: 0.12em;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 0.6rem;
}

.action-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.char-viewport-guide {
  width: 100%;
  height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

@media (max-width: 960px) {
  .char-viewport-guide {
    display: none;
  }
}

.guide-box {
  position: relative;
  width: 380px;
  height: 500px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  pointer-events: auto;
  cursor: pointer;
  transition: border-color 0.3s ease;
}

.guide-box:hover {
  border-color: rgba(215, 255, 0, 0.25);
}

.guide-corner {
  position: absolute;
  width: 12px;
  height: 12px;
  border-color: rgba(255, 255, 255, 0.25);
  border-style: solid;
}

.tl { top: -1px; left: -1px; border-width: 1px 0 0 1px; }
.tr { top: -1px; right: -1px; border-width: 1px 1px 0 0; }
.bl { bottom: -1px; left: -1px; border-width: 0 0 1px 1px; }
.br { bottom: -1px; right: -1px; border-width: 0 1px 1px 0; }

.guide-caption {
  position: absolute;
  bottom: 12px;
  left: 16px;
  font-size: 10px;
  color: var(--text-tertiary);
  letter-spacing: 0.1em;
}
</style>

<script>
const pokeBtn = document.getElementById('btn-poke-char');
if (pokeBtn) {
  pokeBtn.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('characterPoke'));
  });
}

const guideBox = document.querySelector('.guide-box');
if (guideBox) {
  guideBox.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('characterPoke'));
  });
}
</script>
