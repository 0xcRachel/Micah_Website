---
// InteractiveShowcase.astro — Real-Time Engine Inspection Stage
---
<section id="interactive" class="section-wrapper interactive-section" data-section="interactive">
  <div class="container-editorial">
    <div class="interactive-header">
      <span class="badge-tag">
        <span class="dot"></span>
        <span>07 // WORKBENCH</span>
      </span>
      <h2 class="text-title anim-title">DIRECT ENGINE CALIBRATION & SHADER INTERACTION.</h2>
      <p class="interactive-sub text-secondary anim-fade">
        The core WebGL stage runs continuous procedural calculations. Interact with the parameter switches below to modulate surface displacement and chromatic resonance.
      </p>
    </div>

    <!-- Parameter Switchboard Controls -->
    <div class="controls-workbench anim-fade">
      <div class="control-cell">
        <div class="control-label text-mono">
          <span>SURFACE DISPLACEMENT</span>
          <span id="disp-val" class="accent-signal">1.0x</span>
        </div>
        <input type="range" id="slider-distortion" min="0.2" max="2.5" step="0.1" value="1.0" class="tech-slider" />
      </div>

      <div class="control-cell">
        <div class="control-label text-mono">
          <span>ACCENT CHROMA MIX</span>
          <span id="chroma-val" class="accent-signal">0.25</span>
        </div>
        <input type="range" id="slider-chroma" min="0.0" max="1.0" step="0.05" value="0.25" class="tech-slider" />
      </div>

      <div class="control-cell action-cell">
        <button id="btn-pulse-core" class="btn-magnetic btn-ghost-minimal" data-click="secondary">
          <span>DISCHARGE IMPULSE</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.interactive-section {
  border-top: 1px solid var(--border-subtle);
}

.interactive-header {
  max-width: 820px;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  margin-bottom: 4rem;
}

.interactive-sub {
  font-size: var(--font-16);
  line-height: 1.6;
}

.controls-workbench {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  background: rgba(8, 8, 10, 0.7);
  border: 1px solid var(--border-subtle);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  padding: 2.4rem;
}

@media (max-width: 860px) {
  .controls-workbench {
    grid-template-columns: 1fr;
  }
}

.control-cell {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.control-label {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.tech-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 4px;
  background: var(--border-active);
  outline: none;
}

.tech-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  background: var(--accent);
  cursor: pointer;
}

.action-cell {
  justify-content: flex-end;
}
</style>

<script>
const distSlider = document.getElementById('slider-distortion') as HTMLInputElement;
const chromaSlider = document.getElementById('slider-chroma') as HTMLInputElement;
const dispVal = document.getElementById('disp-val');
const chromaVal = document.getElementById('chroma-val');
const pulseBtn = document.getElementById('btn-pulse-core');

if (distSlider && dispVal) {
  distSlider.addEventListener('input', () => {
    dispVal.textContent = `${distSlider.value}x`;
    window.dispatchEvent(new CustomEvent('coreDistortion', { detail: { value: parseFloat(distSlider.value) } }));
  });
}

if (chromaSlider && chromaVal) {
  chromaSlider.addEventListener('input', () => {
    chromaVal.textContent = chromaSlider.value;
    window.dispatchEvent(new CustomEvent('coreChroma', { detail: { value: parseFloat(chromaSlider.value) } }));
  });
}

if (pulseBtn) {
  pulseBtn.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('corePulse'));
  });
}
</script>
