---
// Hero.astro — Editorial Product Launch Hero
import { PRODUCT } from '../data/product';
import { DOWNLOAD_DATA } from '../data/downloads';
---
<section id="hero" class="section-wrapper hero-section" data-section="hero">
  <div class="container-editorial hero-layout">
    <div class="hero-text-block">
      <!-- Section Indicator -->
      <div class="badge-tag hero-badge">
        <span class="dot"></span>
        <span>OFFICIAL RELEASE // {PRODUCT.version}</span>
      </div>

      <!-- Grand Editorial Headline -->
      <h1 class="hero-headline text-hero">
        <span class="hero-word">YOUR</span>
        <span class="hero-word">GAMES.</span><br />
        <span class="hero-word">YOUR</span>
        <span class="hero-word">RULES.</span><br />
        <span class="hero-word accent-signal">ONE</span>
        <span class="hero-word">HUB.</span>
      </h1>

      <!-- Supporting Editorial Subtitle from README -->
      <p class="hero-sub text-statement text-secondary">
        {PRODUCT.heroSub}
      </p>

      <!-- Action Cluster -->
      <div class="hero-actions">
        <a href="#download" class="btn-magnetic btn-primary-signal hero-cta" data-click="primary" data-cursor-label="DOWNLOAD">
          <span>DOWNLOAD FOR WINDOWS</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>

        <a href="#intro" class="btn-magnetic btn-ghost-minimal" data-click="secondary">
          <span>EXPLORE ARCHITECTURE</span>
        </a>
      </div>

      <!-- Real Metrics Grid from README -->
      <div class="hero-metrics-strip">
        {PRODUCT.metrics.map(m => (
          <div class="hero-metric-pill">
            <span class="metric-val text-mono">{m.value}</span>
            <span class="metric-lbl text-mono">{m.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 3D Spatial Canvas Anchor & Aerospace HUD Reticle -->
    <div class="hero-stage-anchor" id="hero-core-anchor" aria-hidden="true">
      <div class="aerospace-reticle">
        <!-- Rotating compass radar ring (alche.studio aesthetic) -->
        <div class="radar-orbit-ring"></div>
        <div class="radar-compass-ring"></div>

        <!-- 4 Wide Perimeter Corner Brackets (no sphere collision) -->
        <span class="hud-bracket b-top-left"></span>
        <span class="hud-bracket b-top-right"></span>
        <span class="hud-bracket b-bottom-left"></span>
        <span class="hud-bracket b-bottom-right"></span>

        <!-- Precision Telemetry Tags -->
        <div class="hud-telemetry tl text-mono">
          <span class="hud-dot"></span>
          <span>SYS // 0xC_KERNEL</span>
        </div>
        <div class="hud-telemetry tr text-mono">
          <span>GLSL_DISP // 60 FPS</span>
        </div>
        <div class="hud-telemetry bl text-mono">
          <span>ORGANIC LIQUID CORE</span>
        </div>
        <div class="hud-telemetry br text-mono">
          <span class="accent-signal">INTERACTIVE</span> // LERP TRACK
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero-section {
  min-height: 100vh;
  padding-top: 140px;
  display: flex;
  align-items: center;
}

.hero-layout {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 4vw;
}

@media (max-width: 992px) {
  .hero-layout {
    grid-template-columns: 1fr;
  }
}

.hero-text-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rem;
  z-index: 2;
}

.hero-badge {
  margin-bottom: 0.5rem;
}

.hero-headline {
  font-family: var(--font-sans);
  color: var(--text-primary);
  display: block;
}

.hero-word {
  display: inline-block;
  will-change: transform, opacity, filter;
}

.hero-sub {
  max-width: 620px;
  font-weight: 400;
  line-height: 1.45;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.4rem;
  margin-top: 0.5rem;
}

.hero-metrics-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.2rem 2.4rem;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-subtle);
  width: 100%;
  max-width: 640px;
}

@media (max-width: 540px) {
  .hero-metrics-strip {
    grid-template-columns: 1fr;
  }
}

.hero-metric-pill {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.metric-val {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.05em;
}

.metric-lbl {
  font-size: 11px;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
}

/* Spatial Aerospace Framing in 3D Zone */
.hero-stage-anchor {
  position: relative;
  width: 100%;
  height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

@media (max-width: 992px) {
  .hero-stage-anchor {
    display: none;
  }
}

.aerospace-reticle {
  position: relative;
  width: 100%;
  max-width: 500px;
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Subtle rotating radar rings */
.radar-orbit-ring {
  position: absolute;
  width: 440px;
  height: 440px;
  border-radius: 50%;
  border: 1px dashed rgba(255, 255, 255, 0.08);
  animation: radar-spin-cw 38s linear infinite;
}

.radar-compass-ring {
  position: absolute;
  width: 390px;
  height: 390px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 0 40px rgba(215, 255, 0, 0.03);
  animation: radar-spin-ccw 26s linear infinite;
}

.radar-compass-ring::after {
  content: '';
  position: absolute;
  top: -4px;
  left: 50%;
  transform: translateX(-50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-primary);
  box-shadow: 0 0 10px var(--accent-primary);
}

@keyframes radar-spin-cw {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes radar-spin-ccw {
  from { transform: rotate(360deg); }
  to   { transform: rotate(0deg); }
}

/* Wide perimeter corner brackets */
.hud-bracket {
  position: absolute;
  width: 16px;
  height: 16px;
  border-color: rgba(255, 255, 255, 0.28);
  border-style: solid;
}

.b-top-left     { top: 0; left: 0; border-width: 1.5px 0 0 1.5px; }
.b-top-right    { top: 0; right: 0; border-width: 1.5px 1.5px 0 0; }
.b-bottom-left  { bottom: 0; left: 0; border-width: 0 0 1.5px 1.5px; }
.b-bottom-right { bottom: 0; right: 0; border-width: 0 1.5px 1.5px 0; }

/* Corner Telemetry Tags */
.hud-telemetry {
  position: absolute;
  font-size: 9.5px;
  color: var(--text-tertiary);
  letter-spacing: 0.16em;
  display: flex;
  align-items: center;
  gap: 6px;
}

.hud-telemetry.tl { top: 6px; left: 24px; }
.hud-telemetry.tr { top: 6px; right: 24px; }
.hud-telemetry.bl { bottom: 6px; left: 24px; }
.hud-telemetry.br { bottom: 6px; right: 24px; }

.hud-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent-primary);
  box-shadow: 0 0 6px var(--accent-primary);
  animation: hud-dot-pulse 1.8s ease-in-out infinite;
}

@keyframes hud-dot-pulse {
  0%, 100% { opacity: 0.3; }
  50%      { opacity: 1.0; }
}
</style>
